<div class="cultos cultos-dialogo-tirada">
  <p class="resumen">
    <strong>{{aspecto.name}}</strong> · {{habilidadLabel}} {{aspecto.system.valor}}
  </p>
  <div class="form-group">
    <label>{{localize "CULTOS.Tirada.Caracteristica"}}</label>
    <select name="caracteristica">
      {{#if sinDefecto}}<option value="" selected>{{localize "CULTOS.Tirada.SinCaracteristica"}}</option>{{/if}}
      {{#each caracteristicas as |c|}}
        <option value="{{c.key}}" {{#if c.selected}}selected{{/if}}>{{c.label}} ({{c.valor}})</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "CULTOS.Tirada.Modificador"}}</label>
    <input type="number" name="modificador" value="0" />
  </div>
</div>
